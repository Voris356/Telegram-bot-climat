# Создайте бота через @BotFather и сохраните токен как секрет.
TELEGRAM_BOT_TOKEN=

# ID личного чата владельца бота; его можно узнать командой /id.
# Владелец должен сначала открыть бота и отправить ему /start.
ADMIN_CHAT_ID=

# Необязательные данные компании. Не указывайте выдуманные адреса или цены.
BUSINESS_NAME=Сервис кондиционеров
SERVICE_CITY=
SERVICE_PHONE=

# Необязательно: DEBUG, INFO, WARNING или ERROR.
LOG_LEVEL=INFO
